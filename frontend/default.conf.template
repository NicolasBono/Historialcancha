server {
    listen 80;

    # Sitio multipágina (index / estadisticas / login), NO una SPA con router:
    # una ruta que no existe tiene que dar 404 y no devolver index.html disfrazado.
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ =404;
    }

    # Todo lo que empiece con /api se reenvía al backend. Como para el browser todo
    # sale del mismo origen, no hace falta CORS.
    #
    # Es una PLANTILLA: la imagen oficial de nginx procesa /etc/nginx/templates/ al
    # arrancar y reemplaza ${BACKEND_URL} y ${DNS_RESOLVER} por las variables de
    # entorno. En compose valen el nombre del servicio y el DNS interno de Docker
    # (los defaults del Dockerfile); en Render, la URL de la api de ESE entorno y un
    # DNS público. Así la misma imagen sirve en QA y en PROD.
    #
    # La dirección va en una VARIABLE de nginx y no escrita dentro del proxy_pass:
    # con el nombre directo, nginx lo resuelve al arrancar y se niega a levantar si
    # el backend todavía no existe ("host not found in upstream"). Con variable,
    # resuelve recién cuando llega un pedido, así el contenedor del front corre solo.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    set $backend_api ${BACKEND_URL};

    location /api/ {
        # SIN barra al final: con barra, nginx reescribe el prefijo y /api/health
        # llegaría al backend como /health — 404 en todas las llamadas.
        proxy_pass $backend_api;
        # La api de Render es https: sin esto el TLS no sabe a qué host va.
        proxy_ssl_server_name on;
    }
}
