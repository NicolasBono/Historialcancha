# Copiá este archivo a .env (git lo ignora) y poné valores reales:
#   cp .env.example .env
#
# Ninguno de estos valores es un secreto de verdad: son plantillas.
# El .env con los valores reales NO se commitea nunca.

# Contraseña del usuario de PostgreSQL.
# Ojo: Postgres la fija cuando inicializa el volumen por primera vez. Si la cambiás
# después, hay que borrar el volumen (docker compose down -v) para que la tome.
DB_PASSWORD=cambiame-por-una-contrasena-local

# Secreto que firma los tokens de sesión. Mínimo 32 caracteres o la app no arranca.
# Generá uno propio, por ejemplo:  openssl rand -base64 48
JWT_KEY=cambiame-por-un-secreto-largo-y-aleatorio-de-32-caracteres-o-mas

# Equipo propio: un rival nunca puede ser este valor.
MI_EQUIPO=Boca Juniors
